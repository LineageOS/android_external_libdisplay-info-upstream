package {
    default_applicable_licenses: ["external_libdisplay_info_upstream_license"],
}

license {
    name: "external_libdisplay_info_upstream_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-MIT",
    ],
    license_text: [
        "LICENSE",
    ],
}

// Generate empty id file rather than importing hwdata library
genrule {
    name: "pnp-ids-upstream",
    cmd: "touch $(out)",
    out: ["pnp.ids"],
}

genrule {
    name: "pnp-id-table-upstream",
    srcs: [":pnp-ids-upstream"],
    tool_files: ["tool/gen-search-table.py"],
    cmd: "$(location tool/gen-search-table.py) $(in) $(out) pnp_id_table",
    out: ["pnp-id-table.c"],
}

// libdisplay_info
cc_library_static {
    name: "libdisplay_info_upstream",
    vendor_available: true,

    export_include_dirs: [
        "include",
    ],

    c_std: "c11",

    srcs: [
        "cta.c",
        "cta-vic-table.c",
        "cvt.c",
        "displayid.c",
        "displayid2.c",
        "dmt-table.c",
        "edid.c",
        "gtf.c",
        "info.c",
        "log.c",
        "memory-stream.c",
    ],
    generated_sources: ["pnp-id-table-upstream"],
}

cc_binary {
    name: "di-edid-decode-upstream",
    vendor_available: true,
    srcs: [
        "di-edid-decode/cta.c",
        "di-edid-decode/displayid.c",
        "di-edid-decode/edid.c",
        "di-edid-decode/main.c",
    ],
    static_libs: [
        "libdisplay_info_upstream",
    ],
}
